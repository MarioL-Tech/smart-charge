# Line endings: the repository always stores LF.
# Windows tools may write CRLF on disk; git normalizes on add/checkout.
* text=auto
*.md text eol=lf
*.py text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.ini text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files (never touch line endings)
*.png binary
*.jpg binary
*.jpeg binary
